{
  "project": "School Safe V2",
  "purpose": "SchoolSafe Brain engineering pack",
  "constitution": "governance/SCHOOLSAFE-LAWS.md",
  "approvedTools": "config/approved-tools.json",
  "cacheRoot": "C:\\SchoolSafe\\AI-TOOLS",
  "memory": {
    "startup": [
      "00-CONTEXT.md",
      "CONTROL-TOWER.md",
      "CURRENT-STATE.md",
      "HANDOFF.md"
    ],
    "durable": [
      "DECISIONS.md",
      "MASTER-PLAN.md"
    ]
  },
  "bootstrap": {
    "defaultTools": ["superpowers", "spec-kit", "repomix"],
    "multiAgentTools": ["orca"],
    "specialistTools": ["openhands", "aider"],
    "securityTools": ["semgrep", "trivy", "gitleaks", "safe-chain"],
    "projectDependencyInstallByDefault": false
  },
  "projectDependencies": {
    "advisoryOnly": true,
    "runtime": ["@tanstack/react-query", "zod", "react-hook-form"],
    "development": ["@biomejs/biome", "@playwright/test", "vitest", "msw", "axe-core", "@lhci/cli"]
  },
  "conditionalTools": ["shadcn/ui", "Magic UI", "Storybook", "Renovate"],
  "rules": {
    "noDirectMain": true,
    "noForcePush": true,
    "noProductionDeploy": true,
    "noProductionSupabaseMutation": true,
    "noSilentToolUpdate": true,
    "humanApprovalRequiredForProduction": true,
    "reuseExistingDownloads": true,
    "useWorktreesForParallelAgents": true,
    "externalReposNeverVendoredIntoApplication": true
  }
}
